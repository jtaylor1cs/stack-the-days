# Copy this file to .env.local and fill in your own Supabase project's values.
# Find them in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — used once by scripts/migrate-posts.mjs to bypass RLS for the
# bulk import of content/posts/*.md into the posts table. Get the service
# role key from Project Settings → API → service_role secret. Do NOT add the
# NEXT_PUBLIC_ prefix — that would ship it to client JS. Remove these two
# lines from .env.local again once the migration has run.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
